# Supabase connection string (Project Settings -> Database -> Connection string -> URI)
# Use the "Session pooler" or direct connection string, and swap the scheme to postgresql+psycopg
# NOTE: [YOUR-PASSWORD] and [YOUR-HOST] below are placeholders to replace, including the
# brackets - don't leave the literal brackets in your real .env file.
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres

# Optional: JSON array of allowed frontend origins, defaults to the Vite dev server
# CORS_ORIGINS=["http://localhost:5173"]

# MusicBrainz asks every client to identify itself with a descriptive User-Agent
# (app name/version + a URL or contact) - see https://musicbrainz.org/doc/MusicBrainz_API#Rate_limiting
# No auth required otherwise.
# If you deploy your own instance, set this to your own app name and contact URL/email.
# MUSICBRAINZ_USER_AGENT=Melodia/0.1 (https://github.com/your-username/melodia)

# Free API key from https://www.last.fm/api/account/create - required for ingestion
LASTFM_API_KEY=

# Supabase project URL (dashboard -> Settings -> API), same value as the frontend's
# VITE_SUPABASE_URL. Used to fetch the project's public JWKS to verify access tokens
# issued by Supabase Auth - required for /chat/*.
SUPABASE_URL=

# Free API key from https://aistudio.google.com/app/apikey - required for analysis
# (artist characteristic classification + embeddings for pgvector similarity search)
GEMINI_API_KEY=

# Optional: analyze newly ingested artists in the background (2 Gemini calls per artist).
# Set to false if the free-tier quota is tight.
# AUTO_ANALYZE=true

# Optional: override the default Gemini models (defaults: gemini-flash-lite-latest,
# gemini-embedding-001 - the Gemini lineup moves fast, check
# https://ai.google.dev/gemini-api/docs/models if either default 404s)
# GEMINI_GENERATION_MODEL=gemini-flash-lite-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
